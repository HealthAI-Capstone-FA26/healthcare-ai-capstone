DATABASE_URL=
# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Mail (SMTP) - vd dung Gmail App Password
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# OTP
OTP_EXPIRES_MINUTES=

# Redis (lưu OTP thay vì bảng Postgres)
REDIS_URL=

# Auth - Login MFA / Session / Lockout (co the chinh trong bang security_settings, day la fallback mac dinh)
ACCESS_TOKEN_TTL_MINUTES=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL_HOURS=
MAX_SESSION_HOURS=
MAX_LOGIN_ATTEMPTS=
LOCKOUT_DURATION_MINUTES=

# Forgot password
RESET_PASSWORD_SECRET=
RESET_TOKEN_TTL_MINUTES=
RABBITMQ_URL=
MINIO_ENDPOINT=
MINIO_PORT=
# Unicode fonts used by prescription PDFs. Windows defaults to Arial; configure paths in Linux/Docker.
PRESCRIPTION_PDF_FONT_PATH=
PRESCRIPTION_PDF_BOLD_FONT_PATH=

# ================== PayOS (Module 6 - Thanh toan) ==================
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# --- PKI / CA (chữ ký số đơn thuốc) ---
# Khoá chủ 32 byte (64 ký tự hex hoặc base64) để mã hoá private key của CA/bác sĩ (AES-256-GCM).
# BẮT BUỘC ở production (NODE_ENV=production). Sinh: openssl rand -hex 32
PKI_MASTER_KEY=
PKI_ORG_NAME=HealthAI Cardiology Clinic
PKI_DOCTOR_CERT_VALID_DAYS=730
# true: tự cấp chứng thư nội bộ cho bác sĩ ở lần ký đầu tiên. Production nên đặt false và cấp qua POST /pki/doctors/:doctorId/certificates
PKI_AUTO_ISSUE=true
