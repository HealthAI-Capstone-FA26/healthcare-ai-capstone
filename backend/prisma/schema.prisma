generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================== USERS ==================

model User {
  userId              String    @id @default(uuid()) @map("user_id") @db.Char(36)
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  status              String    @db.VarChar(20)
  emailVerified       Boolean   @default(false) @map("email_verified")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecret           String?   @map("mfa_secret") @db.VarChar(255)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") // khóa tài khoản tạm thời khi đăng nhập sai quá số lần cho phép
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  profile                      UserProfile?
  session                      UserSession?
  userRoles                    UserRole[]                    @relation("UserRoles")
  assignedUserRoles            UserRole[]                    @relation("AssignedByUser")
  securitySettingsUpdated      SecuritySetting[]
  patient                      Patient?
  doctor                       Doctor?
  patientContacts              PatientContact[]              @relation("PatientContactUser")
  appointmentsBooked           Appointment[]                 @relation("AppointmentBookedBy")
  receptionCheckins            ReceptionCheckin[]            @relation("ReceptionStaffUser")
  staffDepartments             StaffDepartment[]             @relation("StaffDepartments")
  doctorQueueEntriesRouted     DoctorQueueEntry[]            @relation("QueueRoutedByUser")
  chiefComplaintsRecorded      ChiefComplaint[]              @relation("ComplaintRecordedByUser")
  patientIdentityVerifications PatientIdentityVerification[] @relation("IdentityVerifiedByUser")
  consentsWitnessed            Consent[]                     @relation("ConsentWitnessedByUser")
  allergiesRecorded            PatientAllergy[]              @relation("AllergyRecordedByUser")
  allergiesVerified             PatientAllergy[]              @relation("AllergyVerifiedByUser")
  medicalHistoriesRecorded     PatientMedicalHistory[]        @relation("MedicalHistoryRecordedByUser")

  // --- bổ sung theo LogicalDB.drawio ---
  vitalSignSessionsRecorded     VitalSignSession[]             @relation("VitalSessionRecordedByUser")
  vitalSignAlertsConfirmed      VitalSignAlert[]                @relation("VitalAlertConfirmedByUser")
  triageQueueEntriesAssigned    TriageQueueEntry[]              @relation("TriageAssignedNurse")
  diagnosesRecorded             Diagnosis[]                     @relation("DiagnosedByUser")
  aiDiagnosisSuggestionsReviewed AiDiagnosisSuggestion[]        @relation("SuggestionReviewedByUser")
  medicalImagesUploaded         MedicalImage[]                  @relation("ImageUploadedByUser")
  testOrdersOrdered             TestOrder[]                     @relation("TestOrderedByUser")
  paymentsReceived              Payment[]                       @relation("PaymentReceivedByUser")
  notificationsReceived         Notification[]                  @relation("NotificationRecipientUser")
  labStaffRoomAssignments       LabStaffRoomAssignment[]        @relation("LabStaffAssignments")
  labTasksAssigned              LabTask[]                       @relation("LabTaskAssignedStaff")
  labResultsEntered             LabResult[]                     @relation("LabResultEnteredByUser")
  labResultAttachmentsUploaded  LabResultAttachment[]           @relation("LabAttachmentUploadedByUser")
  labResultAlertsConfirmed      LabResultAlert[]                @relation("LabAlertConfirmedByUser")
  prescriptionAlertsConfirmed   PrescriptionSafetyAlert[]       @relation("PrescriptionAlertConfirmedByUser")

  @@map("users")
}

model UserProfile {
  profileId         String   @id @default(uuid()) @map("profile_id") @db.Char(36)
  userId            String   @unique @map("user_id") @db.Char(36)
  actorRole         String   @map("actor_role") @db.VarChar(20)
  fullName          String   @map("full_name") @db.VarChar(255)
  phoneNumber       String?  @map("phone_number") @db.VarChar(20)
  avatarUrl         String?  @map("avatar_url") @db.VarChar(255)
  additionalProfile Json?    @map("additional_profile") @db.JsonB
  fhirResourceId    String?  @map("fhir_resource_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  sessionId        String    @id @default(uuid()) @map("session_id") @db.Char(36)
  userId           String    @unique @map("user_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  expiredAt        DateTime? @map("expired_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_sessions")
}

model Role {
  roleId        String  @id @default(uuid()) @map("role_id") @db.Char(36)
  roleCode      String  @unique @map("role_code") @db.VarChar(36)
  roleName      String  @map("role_name") @db.VarChar(50)
  description   String? @db.VarChar(255)
  isDefaultRole Boolean @default(false) @map("is_default_role")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  permissionId   String @id @default(uuid()) @map("permission_id") @db.Char(36)
  permissionCode String @unique @map("permission_code") @db.VarChar(100)
  description    String @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Char(36)
  roleId     String   @map("role_id") @db.Char(36)
  assignedBy String?  @map("assigned_by") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at")

  user           User  @relation("UserRoles", fields: [userId], references: [userId], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  assignedByUser User? @relation("AssignedByUser", fields: [assignedBy], references: [userId])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model SecuritySetting {
  settingId            String   @id @default(uuid()) @map("setting_id") @db.Char(36)
  idleTimeoutMins      Int      @unique @map("idle_timeout_mins")
  accessTokenTtlMins   Int      @map("access_token_ttl_mins")
  refreshTokenTtlHours Int      @map("refresh_token_ttl_hours")
  maxSessionHours      Int      @map("max_session_hours")
  maxLoginAttempts     Int      @map("max_login_attempts")
  lockoutDurationMins  Int      @map("lockout_duration_mins")
  mfaRequired          Boolean  @default(false) @map("mfa_required")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedBy            String   @map("updated_by") @db.Char(36)

  updatedByUser User @relation(fields: [updatedBy], references: [userId])

  @@map("security_settings")
}

model Department {
  departmentId   String   @id @default(uuid()) @map("department_id") @db.Char(36)
  departmentCode String   @unique @map("department_code") @db.VarChar(20)
  departmentName String   @map("department_name") @db.VarChar(100)
  description    String?  @db.VarChar(255)
  roomLocation   String?  @map("room_location") @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  staffDepartments StaffDepartment[]
  doctorDepartments  DoctorDepartment[]
  doctorSchedules    DoctorSchedule[]
  appointments       Appointment[]
  encounters         Encounter[]
  doctorQueueEntries DoctorQueueEntry[]
  queueTickets       QueueTicket[]

  // --- bổ sung theo LogicalDB.drawio ---
  triageQueueEntries      TriageQueueEntry[]
  examinationFeeCatalogs  ExaminationFeeCatalog[]

  @@map("departments")
}

model Doctor {
  doctorId       String   @id @default(uuid()) @map("doctor_id") @db.Char(36)
  userId         String?  @unique @map("user_id") @db.Char(36)
  doctorCode     String   @unique @map("doctor_code") @db.VarChar(20)
  fullName       String   @map("full_name") @db.VarChar(255)
  title          String?  @db.VarChar(50)
  licenseNumber  String?  @unique @map("license_number") @db.VarChar(50)
  specialization String?  @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  user               User?              @relation(fields: [userId], references: [userId])
  doctorDepartments  DoctorDepartment[]
  doctorSchedules    DoctorSchedule[]
  appointments       Appointment[]
  encounters         Encounter[]
  doctorQueueEntries DoctorQueueEntry[]

  // --- bổ sung theo LogicalDB.drawio ---
  clinicalExaminations   ClinicalExamination[]
  treatmentConsultations TreatmentConsultation[]
  prescriptions          Prescription[]

  @@map("doctors")
}

model StaffDepartment {
  userId       String   @map("user_id") @db.Char(36)
  departmentId String   @map("department_id") @db.Char(36)
  isPrimary    Boolean  @default(true) @map("is_primary")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User       @relation("StaffDepartments", fields: [userId], references: [userId], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [departmentId], onDelete: Cascade)

  @@id([userId, departmentId])
  @@map("staff_departments")
}

model DoctorDepartment {
  doctorId     String  @map("doctor_id") @db.Char(36)
  departmentId String  @map("department_id") @db.Char(36)
  isPrimary    Boolean @default(true) @map("is_primary")
  assignedAt   String? @map("assigned_at") @db.VarChar(255)

  doctor     Doctor     @relation(fields: [doctorId], references: [doctorId], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [departmentId], onDelete: Cascade)

  @@id([doctorId, departmentId])
  @@map("doctor_departments")
}

model DoctorSchedule {
  scheduleId         String   @id @default(uuid()) @map("schedule_id") @db.Char(36)
  doctorId           String   @map("doctor_id") @db.Char(36)
  departmentId       String   @map("department_id") @db.Char(36)
  workDate           DateTime @map("work_date") @db.Date
  session            String   @db.VarChar(20) // morning | afternoon | evening
  startTime          DateTime @map("start_time") @db.Time
  endTime            DateTime @map("end_time") @db.Time
  slotDurationMins   Int      @map("slot_duration_mins")
  maxPatientsPerSlot Int      @map("max_patients_per_slot")
  status             String   @default("active") @db.VarChar(255) // active | cancelled
  createdAt          DateTime @default(now()) @map("created_at")

  doctor           Doctor            @relation(fields: [doctorId], references: [doctorId], onDelete: Cascade)
  department       Department        @relation(fields: [departmentId], references: [departmentId])
  appointmentSlots AppointmentSlot[]

  @@unique([doctorId, workDate, session])
  @@index([doctorId, workDate])
  @@map("doctor_schedules")
}

model AppointmentSlot {
  slotId        String   @id @default(uuid()) @map("slot_id") @db.Char(36)
  scheduleId    String   @map("schedule_id") @db.Char(36)
  slotStartTime DateTime @map("slot_start_time")
  slotEndTime   DateTime @map("slot_end_time")
  capacity      Int
  bookedCount   Int      @default(0) @map("booked_count")
  status        String   @default("free") @db.VarChar(20) // free | full | blocked

  schedule     DoctorSchedule @relation(fields: [scheduleId], references: [scheduleId], onDelete: Cascade)
  appointments Appointment[]

  @@index([scheduleId, status])
  @@map("appointment_slots")
}

// ================== PATIENTS ==================

model Patient {
  patientId          String    @id @default(uuid()) @map("patient_id") @db.Char(36)
  userId             String?   @unique @map("user_id") @db.Char(36)
  patientCode        String    @unique @map("patient_code") @db.VarChar(20)
  fullName           String    @map("full_name") @db.VarChar(255)
  dateOfBirth        DateTime  @map("date_of_birth") @db.Date
  gender             String    @db.VarChar(10) // male | female | other | unknown
  identityNumber     String?   @unique @map("identity_number") @db.VarChar(20)
  insuranceNumber    String?   @unique @map("insurance_number") @db.VarChar(20)
  phoneNumber        String    @map("phone_number") @db.VarChar(20)
  status             String    @default("draft") @db.VarChar(10) // draft: đặt lịch guest chưa xác nhận, main: hồ sơ chính thức
  email              String?   @db.VarChar(255)
  address            String?   @db.VarChar(255)
  ethnicity          String?   @db.VarChar(50)
  isActive           Boolean   @default(true) @map("is_active")
  identityVerified   Boolean   @default(false) @map("identity_verified")
  identityVerifiedAt DateTime? @map("identity_verified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user            User?            @relation(fields: [userId], references: [userId])
  patientContacts PatientContact[]
  appointments    Appointment[]    @relation("AppointmentPatient")
  // Appointment ở case "matched nhưng chưa xác nhận" (guest booking, xem GuestAppointmentService):
  // patientId để null, chỉ set suggestedPatientId trỏ tới patient MAIN khớp nhất. Lễ tân xác nhận
  // qua POST /appointment/sync-patient (Phase 3) rồi mới set patientId thật.
  suggestedAppointments Appointment[] @relation("AppointmentSuggestedPatient")
  encounters      Encounter[]
  consents        Consent[]
  allergies       PatientAllergy[]
  medicalHistories PatientMedicalHistory[]

  // --- bổ sung theo LogicalDB.drawio ---
  vitalSignSessions         VitalSignSession[]
  medicalImages             MedicalImage[]
  invoices                  Invoice[]
  notifications             Notification[]
  encounterSummaryDocuments EncounterSummaryDocument[]

  @@index([status, createdAt])
  @@map("patients")
}

model PatientContact {
  contactId        String   @id @default(uuid()) @map("contact_id") @db.Char(36)
  userId           String   @map("user_id") @db.Char(36)
  patientId        String   @map("patient_id") @db.Char(36)
  relationship     String   @db.VarChar(255) // self | parent | child | spouse | guardian | other
  isPrimaryContact Boolean  @default(false) @map("is_primary_contact")
  createdAt        DateTime @default(now()) @map("created_at")

  user    User    @relation("PatientContactUser", fields: [userId], references: [userId])
  patient Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@unique([userId, patientId])
  @@map("patient_contacts")
}

model Appointment {
  appointmentId   String    @id @default(uuid()) @map("appointment_id") @db.Char(36)
  appointmentCode String    @unique @map("appointment_code") @db.VarChar(20)
  // Nullable: case "matched nhưng chưa xác nhận" (guest booking match được ≥2 field với 1 patient
  // MAIN có sẵn) để patientId=null, chỉ set suggestedPatientId — chờ lễ tân đối chiếu qua
  // POST /appointment/sync-patient (Phase 3) rồi mới set patientId thật. Các thao tác giả định
  // luôn có patientId (check-in, tạo encounter) phải tự chặn khi null — xem QueueTicketService.done()
  // và EncounterService.createFromCheckin().
  patientId          String?   @map("patient_id") @db.Char(36)
  // Ứng viên Patient (status='main') khớp nhất tìm được lúc guest đặt lịch, kèm suggestedReason
  // ghi rõ field nào khớp (vd 'fullName,phoneNumber'). Giữ nguyên kể cả sau khi patientId đã được
  // set (sync-patient không xoá) để còn audit trail.
  suggestedPatientId String?   @map("suggested_patient_id") @db.Char(36)
  suggestedReason    String?   @map("suggested_reason") @db.VarChar(255)
  doctorId        String?   @map("doctor_id") @db.Char(36)
  departmentId    String    @map("department_id") @db.Char(36)
  slotId          String?   @map("slot_id") @db.Char(36)
  bookedByUserId  String?   @map("booked_by_user_id") @db.Char(36)
  bookingChannel  String    @map("booking_channel") @db.VarChar(20) // online | at_hospital
  appointmentDate DateTime  @map("appointment_date") @db.Date
  appointmentTime DateTime? @map("appointment_time") @db.Time
  status          String    @default("pending") @db.VarChar(20)
  // pending -> confirmed -> checked_in -> in_progress -> completed || cancelled || no_show
  reasonForVisit  String?   @map("reason_for_visit") @db.VarChar(255)
  priority        String    @default("normal") @db.VarChar(20) // normal | urgent | emergency
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason") @db.VarChar(255)

  patient          Patient?         @relation("AppointmentPatient", fields: [patientId], references: [patientId])
  suggestedPatient Patient?         @relation("AppointmentSuggestedPatient", fields: [suggestedPatientId], references: [patientId])
  doctor       Doctor?          @relation(fields: [doctorId], references: [doctorId])
  department   Department       @relation(fields: [departmentId], references: [departmentId])
  slot         AppointmentSlot? @relation(fields: [slotId], references: [slotId])
  bookedByUser User?            @relation("AppointmentBookedBy", fields: [bookedByUserId], references: [userId])

  encounter         Encounter?
  queueTicket       QueueTicket?
  receptionCheckins ReceptionCheckin[]

  @@index([departmentId, appointmentDate, status])
  @@index([patientId, appointmentDate(sort: Desc)])
  @@index([suggestedPatientId])
  @@map("appointments")
}

model Encounter {
  encounterId   String    @id @default(uuid()) @map("encounter_id") @db.Char(36)
  appointmentId String    @unique @map("appointment_id") @db.Char(36)
  patientId     String    @map("patient_id") @db.Char(36)
  departmentId  String    @map("department_id") @db.Char(36)
  doctorId      String?   @map("doctor_id") @db.Char(36)
  encounterCode String    @unique @map("encounter_code") @db.VarChar(20)
  patientType   String    @map("patient_type") @db.VarChar(20) // new | returning
  status        String    @default("arrived") @db.VarChar(20) // arrived -> registered -> waiting_for_doctor -> in_progress -> finished || cancelled
  arrivedAt     DateTime  @default(now()) @map("arrived_at")
  registeredAt  DateTime? @map("registered_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [patientId])
  department  Department  @relation(fields: [departmentId], references: [departmentId])
  doctor      Doctor?     @relation(fields: [doctorId], references: [doctorId])

  chiefComplaint        ChiefComplaint?
  identityVerifications PatientIdentityVerification[]
  doctorQueueEntry      DoctorQueueEntry?
  consents              Consent[]
  allergies             PatientAllergy[]
  medicalHistories      PatientMedicalHistory[]

  // --- bổ sung theo LogicalDB.drawio ---
  vitalSignSessions       VitalSignSession[]
  vitalSignAlerts         VitalSignAlert[]
  triageQueueEntry        TriageQueueEntry?
  clinicalExamination     ClinicalExamination?
  diagnoses               Diagnosis[]
  aiClinicalSummary       AiClinicalSummary?
  aiDiagnosisSuggestions  AiDiagnosisSuggestion[]
  aiReferenceSources      AiReferenceSource[]
  medicalImages           MedicalImage[]
  testOrders              TestOrder[]
  invoices                Invoice[]
  labResultAlerts         LabResultAlert[]
  treatmentConsultation   TreatmentConsultation?
  prescriptions           Prescription[]
  encounterSummaryDocuments EncounterSummaryDocument[]

  @@index([patientId, arrivedAt(sort: Desc)])
  @@index([status, departmentId])
  @@map("encounters")
}

model ChiefComplaint {
  complaintId      String    @id @default(uuid()) @map("complaint_id") @db.Char(36)
  encounterId      String    @unique @map("encounter_id") @db.Char(36)
  reasonForVisit   String?   @map("reason_for_visit") @db.VarChar(255)
  symptoms         String?   @db.Text
  symptomOnsetDate DateTime? @map("symptom_onset_date") @db.Date
  painLevel        Int?      @map("pain_level")
  inputChannel     String    @map("input_channel") @db.VarChar(50) // self_kiosk | receptionist_assisted | online_pre_visit
  recordedByUserId String?   @map("recorded_by_user_id") @db.Char(36) // NULL khi bệnh nhân tự nhập qua kiosk/app (self_kiosk)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  encounter      Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  recordedByUser User?     @relation("ComplaintRecordedByUser", fields: [recordedByUserId], references: [userId])

  @@map("chief_complaints")
}

model PatientIdentityVerification {
  verificationId     String   @id @default(uuid()) @map("verification_id") @db.Char(36)
  encounterId        String   @map("encounter_id") @db.Char(36)
  verifiedByUserId   String   @map("verified_by_user_id") @db.Char(36)
  verificationMethod String   @map("verification_method") @db.VarChar(50) // national_id_card | health_insurance_card | patient_card | manual
  verificationStatus String   @map("verification_status") @db.VarChar(20) // verified | failed | pending
  mismatchNotes      String?  @map("mismatch_notes") @db.VarChar(255)
  verifiedAt         DateTime @map("verified_at")

  encounter      Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  verifiedByUser User      @relation("IdentityVerifiedByUser", fields: [verifiedByUserId], references: [userId])

  @@index([encounterId, verifiedAt(sort: Desc)])
  @@map("patient_identity_verifications")
}

model DoctorQueueEntry {
  queueEntryId   String    @id @default(uuid()) @map("queue_entry_id") @db.Char(36)
  encounterId    String    @unique @map("encounter_id") @db.Char(36)
  doctorId       String    @map("doctor_id") @db.Char(36)
  departmentId   String    @map("department_id") @db.Char(36)
  queueOrder     Int       @map("queue_order")
  priority       String    @default("normal") @db.VarChar(20) // normal | urgent | emergency
  status         String    @default("waiting") @db.VarChar(20) // waiting | called | in_progress | done | skipped | cancelled
  enteredQueueAt DateTime  @default(now()) @map("entered_queue_at")
  doctorQueueDate DateTime @map("doctor_queue_date") @db.Date // bổ sung theo LogicalDB.drawio
  calledAt       DateTime? @map("called_at")
  examStartedAt  DateTime? @map("exam_started_at")
  routedByUserId String?   @map("routed_by_user_id") @db.Char(36)

  encounter    Encounter  @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  doctor       Doctor     @relation(fields: [doctorId], references: [doctorId])
  department   Department @relation(fields: [departmentId], references: [departmentId])
  routedByUser User?      @relation("QueueRoutedByUser", fields: [routedByUserId], references: [userId])

  @@index([doctorId, status, queueOrder])
  @@unique([departmentId, doctorQueueDate, queueOrder]) // bổ sung theo LogicalDB.drawio
  @@map("doctor_queue_entries")
}

model QueueTicket {
  ticketId      String    @id @default(uuid()) @map("ticket_id") @db.Char(36)
  appointmentId String    @unique @map("appointment_id") @db.Char(36)
  departmentId  String    @map("department_id") @db.Char(36)
  ticketPrefix  String    @map("ticket_prefix") @db.Char(1)
  ticketDate    DateTime  @map("ticket_date") @db.Date
  ticketNumber  Int       @map("ticket_number")
  calledAt      DateTime? @map("called_at")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  status        String    @default("waiting") @db.VarChar(20) // waiting | called | serving | done | skipped | cancelled
  counterNumber String?   @map("counter_number") @db.VarChar(20)

  appointment Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)
  department  Department  @relation(fields: [departmentId], references: [departmentId])

  @@unique([departmentId, ticketPrefix, ticketDate, ticketNumber])
  @@index([departmentId, ticketDate, status])
  @@map("queue_tickets")
}

model ReceptionCheckin {
  checkinId            String   @id @default(uuid()) @map("checkin_id") @db.Char(36)
  appointmentId        String   @map("appointment_id") @db.Char(36)
  receptionStaffUserId String   @map("reception_staff_user_id") @db.Char(36)
  checkinTime          DateTime @default(now()) @map("checkin_time")
  counterNumber        String?  @map("counter_number") @db.VarChar(20)
  notes                String?  @db.VarChar(255)

  appointment        Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)
  receptionStaffUser User        @relation("ReceptionStaffUser", fields: [receptionStaffUserId], references: [userId])

  @@map("reception_checkins")
}

// ================== CONSENTS ==================

model ConsentPolicy {
  policyId      String    @id @default(uuid()) @map("policy_id") @db.Char(36)
  policyCode    String    @unique @map("policy_code") @db.VarChar(50)
  policyType    String    @map("policy_type") @db.VarChar(30)
  version       String    @db.VarChar(20)
  contentUrl    String    @map("content_url") @db.VarChar(255)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  consents Consent[]

  @@unique([policyType, version])
  @@map("consent_policies")
}

model Consent {
  consentId         String    @id @default(uuid()) @map("consent_id") @db.Char(36)
  patientId         String    @map("patient_id") @db.Char(36)
  encounterId       String?   @map("encounter_id") @db.Char(36)
  policyId          String    @map("policy_id") @db.Char(36)
  signatureType     String    @map("signature_type") @db.VarChar(20) // e_signature_draw | otp_confirmed | checkbox_click
  signatureDataUrl  String?   @map("signature_data_url") @db.VarChar(255)
  signedAt          DateTime  @default(now()) @map("signed_at")
  checkedAt         DateTime? @map("checked_at") // bổ sung theo LogicalDB.drawio (CONSENTS.checked_at)
  witnessedByUserId String?   @map("witnessed_by_user_id") @db.Char(36)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  deviceInfo        String?   @map("device_info") @db.VarChar(255)
  status            String    @default("active") @db.VarChar(20) // active | revoked
  revokedAt         DateTime? @map("revoked_at")
  revokeReason      String?   @map("revoke_reason") @db.VarChar(255)

  patient         Patient       @relation(fields: [patientId], references: [patientId])
  encounter       Encounter?    @relation(fields: [encounterId], references: [encounterId])
  policy          ConsentPolicy @relation(fields: [policyId], references: [policyId])
  witnessedByUser User?         @relation("ConsentWitnessedByUser", fields: [witnessedByUserId], references: [userId])

  @@index([patientId, status])
  @@map("consents")
}

// ================== PATIENT LONG-TERM RECORDS ==================
// (dị ứng / tiền sử — hồ sơ dài hạn, không gắn cứng 1 encounter; encounterId chỉ để audit
// lượt khám nào đã khai báo, khoá sở hữu chính vẫn là patientId — theo module3.md mục 3)

model PatientAllergy {
  allergyId           String   @id @default(uuid()) @map("allergy_id") @db.Char(36)
  patientId           String   @map("patient_id") @db.Char(36)
  allergyType         String   @map("allergy_type") @db.VarChar(20) // drug | food | environmental | other
  substanceCode       String?  @map("substance_code") @db.VarChar(50) // bổ sung theo LogicalDB.drawio
  verificationStatus  String   @default("unconfirmed") @map("verification_status") @db.VarChar(20) // bổ sung theo LogicalDB.drawio: unconfirmed | confirmed | refuted
  allergenName        String   @map("allergen_name") @db.VarChar(255)
  reactionDescription String?  @map("reaction_description") @db.Text
  severity            String   @db.VarChar(20) // mild | moderate | severe | life_threatening
  recordedByUserId    String?  @map("recorded_by_user_id") @db.Char(36)
  verifiedByUserId    String?  @map("verified_by_user_id") @db.Char(36) // bổ sung theo LogicalDB.drawio
  encounterId         String?  @map("encounter_id") @db.Char(36)
  recordedAt          DateTime @default(now()) @map("recorded_at")
  status              String   @default("active") @db.VarChar(20) // active | resolved | entered_in_error
  createdAt           DateTime @default(now()) @map("created_at")

  patient         Patient    @relation(fields: [patientId], references: [patientId])
  encounter       Encounter? @relation(fields: [encounterId], references: [encounterId])
  recordedByUser  User?      @relation("AllergyRecordedByUser", fields: [recordedByUserId], references: [userId])
  verifiedByUser  User?      @relation("AllergyVerifiedByUser", fields: [verifiedByUserId], references: [userId])

  @@index([patientId, status])
  @@map("patient_allergies")
}

model PatientMedicalHistory {
  historyId        String    @id @default(uuid()) @map("history_id") @db.Char(36)
  patientId        String    @map("patient_id") @db.Char(36)
  historyType      String    @map("history_type") @db.VarChar(20) // chronic_disease | surgery | family_history
  conditionName    String    @map("condition_name") @db.VarChar(255)
  icd10Code        String?   @map("icd10_code") @db.VarChar(10)
  onsetDate        DateTime? @map("onset_date") @db.Date
  notes            String?   @db.Text
  recordedByUserId String?   @map("recorded_by_user_id") @db.Char(36)
  encounterId      String?   @map("encounter_id") @db.Char(36)
  recordedAt       DateTime  @default(now()) @map("recorded_at")
  status           String    @default("active") @db.VarChar(20) // active | resolved | inactive
  createdAt        DateTime  @default(now()) @map("created_at")

  patient        Patient    @relation(fields: [patientId], references: [patientId])
  encounter      Encounter? @relation(fields: [encounterId], references: [encounterId])
  recordedByUser User?      @relation("MedicalHistoryRecordedByUser", fields: [recordedByUserId], references: [userId])
  icd10          Icd10Code? @relation(fields: [icd10Code], references: [icd10Code]) // bổ sung theo LogicalDB.drawio

  @@index([patientId, historyType])
  @@map("patient_medical_history")
}

// ============================================================
// BỔ SUNG THEO LogicalDB.drawio (các bảng còn thiếu trong schema gốc)
// Lưu ý: một vài kiểu dữ liệu trong file drawio bị lỗi đánh máy rõ ràng
// (vd. NOTIFICATIONS.title/content/status ghi là DATETIME, ENCOUNTER_SUMMARY_DOCUMENTS.pdf_file_url
// ghi là DECIMAL, LAB_STAFF_ROOM_ASSIGNMENTS.is_primary ghi là VARCHAR...). Các trường này được
// đưa về kiểu dữ liệu hợp lý dựa theo tên trường thay vì chép nguyên kiểu bị lỗi trong file gốc.
// ============================================================

// ================== VITAL SIGNS ==================

model VitalSignItem {
  itemId       String   @id @default(uuid()) @map("item_id") @db.Char(36)
  itemCode     String   @unique @map("item_code") @db.VarChar(20)
  itemName     String   @map("item_name") @db.VarChar(100)
  loincCode    String?  @map("loinc_code") @db.VarChar(20)
  unit         String   @db.VarChar(20)
  isCalculated Boolean  @default(false) @map("is_calculated")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  vitalSignObservations VitalSignObservation[]
  vitalSignThresholds   VitalSignThreshold[]

  @@map("vital_sign_items")
}

model VitalSignSession {
  vitalSessionId   String   @id @default(uuid()) @map("vital_session_id") @db.Char(36)
  encounterId      String   @map("encounter_id") @db.Char(36)
  patientId        String   @map("patient_id") @db.Char(36)
  recordedByUserId String   @map("recorded_by_user_id") @db.Char(36)
  measuredAt       DateTime @map("measured_at")
  notes            String?  @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")

  encounter      Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  patient        Patient   @relation(fields: [patientId], references: [patientId])
  recordedByUser User      @relation("VitalSessionRecordedByUser", fields: [recordedByUserId], references: [userId])

  observations       VitalSignObservation[]
  triageQueueEntries  TriageQueueEntry[]

  @@map("vital_sign_sessions")
}

model VitalSignObservation {
  observationId    String   @id @default(uuid()) @map("observation_id") @db.Char(36)
  vitalSessionId   String   @map("vital_session_id") @db.Char(36)
  itemId           String   @map("item_id") @db.Char(36)
  observationValue Decimal  @map("observation_value") @db.Decimal(10, 2)
  isAbnormal       Boolean  @default(false) @map("is_abnormal")
  createdAt        DateTime @default(now()) @map("created_at")

  vitalSession VitalSignSession @relation(fields: [vitalSessionId], references: [vitalSessionId], onDelete: Cascade)
  item         VitalSignItem    @relation(fields: [itemId], references: [itemId])

  vitalSignAlerts VitalSignAlert[]

  @@unique([vitalSessionId, itemId])
  @@map("vital_sign_observations")
}

model VitalSignThreshold {
  vitalThresholdId String   @id @default(uuid()) @map("vital_threshold_id") @db.Char(36)
  itemId           String   @map("item_id") @db.Char(36)
  ageMin           Int?     @map("age_min")
  ageMax           Int?     @map("age_max")
  gender           String?  @db.VarChar(10)
  minNormal        Decimal  @map("min_normal") @db.Decimal(10, 2)
  maxNormal        Decimal  @map("max_normal") @db.Decimal(10, 2)
  effectiveFrom    DateTime @map("effective_from") @db.Date
  isActive         Boolean  @default(true) @map("is_active")
  sourceReference  String?  @map("source_reference") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  item VitalSignItem @relation(fields: [itemId], references: [itemId])

  vitalSignAlerts VitalSignAlert[]

  @@map("vital_sign_thresholds")
}

model VitalSignAlert {
  alertId           String    @id @default(uuid()) @map("alert_id") @db.Char(36)
  observationId     String    @map("observation_id") @db.Char(36)
  encounterId       String    @map("encounter_id") @db.Char(36)
  vitalThresholdId  String?   @map("vital_threshold_id") @db.Char(36)
  alertLevel        String    @map("alert_level") @db.VarChar(20) // critical (out-of-range của normal - không còn "warning")
  alertSource       String    @map("alert_source") @db.VarChar(20) // rule | ai
  measuredValue     Decimal   @map("measured_value") @db.Decimal(10, 2)
  expectedMin       Decimal?  @map("expected_min") @db.Decimal(10, 2)
  expectedMax       Decimal?  @map("expected_max") @db.Decimal(10, 2)
  reason            String?   @map("reason") @db.VarChar(500)
  status            String    @default("active") @db.VarChar(20) // active | confirmed | resolved
  confirmedByUserId String?   @map("confirmed_by_user_id") @db.Char(36)
  confirmedAt       DateTime? @map("confirmed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  observation     VitalSignObservation @relation(fields: [observationId], references: [observationId], onDelete: Cascade)
  encounter       Encounter            @relation(fields: [encounterId], references: [encounterId])
  vitalThreshold  VitalSignThreshold?  @relation(fields: [vitalThresholdId], references: [vitalThresholdId])
  confirmedByUser User?                @relation("VitalAlertConfirmedByUser", fields: [confirmedByUserId], references: [userId])

  @@map("vital_sign_alerts")
}

// ================== TRIAGE / KHÁM LÂM SÀNG ==================

model TriageQueueEntry {
  queueEntryId        String    @id @default(uuid()) @map("queue_entry_id") @db.Char(36)
  encounterId         String    @unique @map("encounter_id") @db.Char(36)
  assignedNurseUserId String    @map("assigned_nurse_user_id") @db.Char(36)
  departmentId        String    @map("department_id") @db.Char(36)
  priority            String    @default("normal") @db.VarChar(20) // normal | urgent | emergency
  queueOrder          Int       @map("queue_order")
  status              String    @default("waiting") @db.VarChar(20) // waiting | called | in_progress | done | skipped | cancelled
  triageQueueDate     DateTime  @map("triage_queue_date") @db.Date
  enteredQueueAt      DateTime  @default(now()) @map("entered_queue_at")
  calledAt            DateTime? @map("called_at")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  sessionId           String?   @map("session_id") @db.Char(36)

  encounter         Encounter         @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  assignedNurseUser User              @relation("TriageAssignedNurse", fields: [assignedNurseUserId], references: [userId])
  department        Department        @relation(fields: [departmentId], references: [departmentId])
  vitalSignSession  VitalSignSession? @relation(fields: [sessionId], references: [vitalSessionId])

  @@unique([departmentId, triageQueueDate, queueOrder])
  @@map("triage_queue_entries")
}

model ClinicalExamination {
  examinationId       String   @id @default(uuid()) @map("examination_id") @db.Char(36)
  encounterId         String   @unique @map("encounter_id") @db.Char(36)
  doctorId            String   @map("doctor_id") @db.Char(36)
  examinationFindings String   @map("examination_findings") @db.Text
  clinicalNotes       String?  @map("clinical_notes") @db.Text
  examinedAt          DateTime @map("examined_at")
  createdAt           DateTime @default(now()) @map("created_at")

  encounter Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  doctor    Doctor    @relation(fields: [doctorId], references: [doctorId])

  @@map("clinical_examinations")
}

// ================== CHẨN ĐOÁN / ICD-10 / AI ==================

model Icd10Code {
  icd10Code   String   @id @map("icd10_code") @db.VarChar(10)
  icd10Name   String   @map("icd10_name") @db.VarChar(255)
  icd10NameVi String?  @map("icd10_name_vi") @db.VarChar(255)
  chapter     String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  isCurable   Boolean? @map("is_curable")

  diagnoses                    Diagnosis[]
  diagnosisTestRecommendations DiagnosisTestRecommendation[]
  aiDiagnosisSuggestions       AiDiagnosisSuggestion[]
  patientMedicalHistories      PatientMedicalHistory[]

  @@map("icd10_codes")
}

model Diagnosis {
  diagnosisId       String   @id @default(uuid()) @map("diagnosis_id") @db.Char(36)
  encounterId       String   @map("encounter_id") @db.Char(36)
  icd10Code         String   @map("icd10_code") @db.VarChar(10)
  diagnosisName     String   @map("diagnosis_name") @db.VarChar(255)
  diagnosisType     String   @map("diagnosis_type") @db.VarChar(20)
  aiSuggestionId    String?  @map("ai_suggestion_id") @db.Char(36)
  diagnosedByUserId String   @map("diagnosed_by_user_id") @db.Char(36)
  isPrimary         Boolean  @default(false) @map("is_primary")
  notes             String?  @db.VarChar(255)
  diagnosedAt       DateTime @map("diagnosed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  encounter       Encounter              @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  icd10           Icd10Code              @relation(fields: [icd10Code], references: [icd10Code])
  aiSuggestion    AiDiagnosisSuggestion? @relation(fields: [aiSuggestionId], references: [suggestionId])
  diagnosedByUser User                   @relation("DiagnosedByUser", fields: [diagnosedByUserId], references: [userId])

  testOrders    TestOrder[]
  prescriptions Prescription[]

  @@map("diagnoses")
}

model AiClinicalSummary {
  summaryId    String   @id @default(uuid()) @map("summary_id") @db.Char(36)
  encounterId  String   @unique @map("encounter_id") @db.Char(36)
  modelName    String   @map("model_name") @db.VarChar(100)
  modelVersion String?  @map("model_version") @db.VarChar(20)
  summaryText  String   @map("summary_text") @db.Text
  status       String   @default("generated") @db.VarChar(20) // generated | viewed | dismissed
  generatedAt  DateTime @map("generated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  encounter Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)

  @@map("ai_clinical_summaries")
}

model AiReferenceSource {
  referenceId       String   @id @default(uuid()) @map("reference_id") @db.Char(36)
  ownerId           String   @map("owner_id") @db.Char(36)
  ownerType         String   @map("owner_type") @db.VarChar(30) // clinical_summary | diagnosis_suggestion
  sourceType        String   @map("source_type") @db.VarChar(30)
  sourceId          String   @map("source_id") @db.Char(36)
  sourceEncounterId String?  @map("source_encounter_id") @db.Char(36)
  relevanceNote     String?  @map("relevance_note") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")

  sourceEncounter Encounter? @relation(fields: [sourceEncounterId], references: [encounterId])

  @@map("ai_reference_sources")
}

model AiDiagnosisSuggestion {
  suggestionId      String    @id @default(uuid()) @map("suggestion_id") @db.Char(36)
  encounterId       String    @map("encounter_id") @db.Char(36)
  sourceType        String    @map("source_type") @db.VarChar(30) // initial_summary | lab_analysis | imaging_analysis | comprehensive_review
  sourceId          String?   @map("source_id") @db.Char(36)
  explanationText   String?   @map("explanation_text") @db.Text
  modelName         String    @map("model_name") @db.VarChar(100)
  modelVersion      String?   @map("model_version") @db.VarChar(20)
  icd10Code         String    @map("icd10_code") @db.VarChar(10)
  suggestedDiagName String    @map("suggested_diag_name") @db.VarChar(255)
  confidenceScore   Decimal   @map("confidence_score") @db.Decimal(5, 4)
  rank              Int // top-k
  generatedAt       DateTime  @map("generated_at")
  doctorFeedback    String?   @map("doctor_feedback") @db.VarChar(20) // accepted | rejected | modified
  rejectionReason   String?   @map("rejection_reason") @db.Text
  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Char(36)
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  encounter      Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  icd10          Icd10Code @relation(fields: [icd10Code], references: [icd10Code])
  reviewedByUser User?     @relation("SuggestionReviewedByUser", fields: [reviewedByUserId], references: [userId])

  diagnoses Diagnosis[]

  @@map("ai_diagnosis_suggestions")
}

// ================== HÌNH ẢNH Y KHOA / AI ==================

model MedicalImage {
  imageId          String   @id @default(uuid()) @map("image_id") @db.Char(36)
  encounterId      String   @map("encounter_id") @db.Char(36)
  patientId        String?  @map("patient_id") @db.Char(36)
  imageType        String   @map("image_type") @db.VarChar(20) // xray | ct | mri | ultrasound | ecg | other
  fileUrl          String?  @map("file_url") @db.VarChar(255)
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Char(36)
  labResultId      String   @map("lab_result_id") @db.Char(36)
  capturedAt       DateTime @map("captured_at")
  uploadedAt       DateTime @map("uploaded_at")
  createdAt        DateTime @default(now()) @map("created_at")

  encounter      Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  patient        Patient?  @relation(fields: [patientId], references: [patientId])
  uploadedByUser User      @relation("ImageUploadedByUser", fields: [uploadedByUserId], references: [userId])
  labResult      LabResult @relation(fields: [labResultId], references: [labResultId])

  aiImagingAnalyses AiImagingAnalysis[]

  @@map("medical_images")
}

model AiImagingAnalysis {
  analysisId        String   @id @default(uuid()) @map("analysis_id") @db.Char(36)
  imageId           String   @map("image_id") @db.Char(36)
  modelName         String   @map("model_name") @db.VarChar(100)
  modelVersion      String?  @map("model_version") @db.VarChar(20)
  overallFinding    String?  @map("overall_finding") @db.VarChar(255)
  confidenceScore   Decimal  @map("confidence_score") @db.Decimal(5, 4)
  annotatedImageUrl String?  @map("annotated_image_url") @db.VarChar(255)
  analyzedAt        DateTime @map("analyzed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  image MedicalImage @relation(fields: [imageId], references: [imageId], onDelete: Cascade)

  findings AiImagingFinding[]

  @@map("ai_imaging_analyses")
}

model AiImagingFinding {
  findingId       String   @id @default(uuid()) @map("finding_id") @db.Char(36)
  analysisId      String   @map("analysis_id") @db.Char(36)
  findingLabel    String   @map("finding_label") @db.VarChar(255)
  confidenceScore Decimal  @map("confidence_score") @db.Decimal(5, 4)
  boundingBox     Json     @map("bounding_box") @db.JsonB // {x, y, width, height}
  severity        String?  @db.VarChar(20) // mild | moderate | severe
  createdAt       DateTime @default(now()) @map("created_at")

  analysis AiImagingAnalysis @relation(fields: [analysisId], references: [analysisId], onDelete: Cascade)

  @@map("ai_imaging_findings")
}

// ================== XÉT NGHIỆM / DANH MỤC ==================

model TestCatalog {
  testTypeId          String   @id @default(uuid()) @map("test_type_id") @db.Char(36)
  testCode            String   @unique @map("test_code") @db.VarChar(20)
  testName            String   @map("test_name") @db.VarChar(255)
  category            String   @db.VarChar(30) // blood | imaging | urine | microbiology | biochemistry | ...
  specimenType        String?  @map("specimen_type") @db.VarChar(50)
  price               Decimal  @db.Decimal(12, 2)
  turnaroundTimeHours Int?     @map("turnaround_time_hours")
  defaultLabRoomId    String   @map("default_lab_room_id") @db.Char(36)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  defaultLabRoom LabRoom @relation(fields: [defaultLabRoomId], references: [labRoomId])

  diagnosisTestRecommendations DiagnosisTestRecommendation[]
  testOrderItems                TestOrderItem[]
  labResultParameters           LabResultParameter[]

  @@map("test_catalog")
}

model DiagnosisTestRecommendation {
  recommendationId String   @id @default(uuid()) @map("recommendation_id") @db.Char(36)
  icd10Code        String   @map("icd10_code") @db.VarChar(10)
  testTypeId       String   @map("test_type_id") @db.Char(36)
  priority         String   @default("recommended") @db.VarChar(20) // recommended | optional
  rationale        String?  @db.VarChar(255)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  icd10    Icd10Code   @relation(fields: [icd10Code], references: [icd10Code])
  testType TestCatalog @relation(fields: [testTypeId], references: [testTypeId])

  @@map("diagnosis_test_recommendations")
}

model TestOrder {
  orderId         String   @id @default(uuid()) @map("order_id") @db.Char(36)
  orderCode       String   @unique @map("order_code") @db.VarChar(20)
  encounterId     String   @map("encounter_id") @db.Char(36)
  orderedByUserId String   @map("ordered_by_user_id") @db.Char(36)
  diagnosisId     String?  @map("diagnosis_id") @db.Char(36)
  status          String   @default("ordered") @db.VarChar(20) // ordered | in_progress | completed | cancelled
  orderedAt       DateTime @map("ordered_at")
  notes           String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  encounter     Encounter  @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  orderedByUser User       @relation("TestOrderedByUser", fields: [orderedByUserId], references: [userId])
  diagnosis     Diagnosis? @relation(fields: [diagnosisId], references: [diagnosisId])

  items TestOrderItem[]

  @@map("test_orders")
}

model TestOrderItem {
  orderItemId    String   @id @default(uuid()) @map("order_item_id") @db.Char(36)
  orderId        String   @map("order_id") @db.Char(36)
  testTypeId     String   @map("test_type_id") @db.Char(36)
  wasAiSuggested Boolean  @default(false) @map("was_ai_suggested")
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  status         String   @default("ordered") @db.VarChar(20) // ordered | sample_collected | in_progress | completed | cancelled
  createdAt      DateTime @default(now()) @map("created_at")

  order    TestOrder   @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  testType TestCatalog @relation(fields: [testTypeId], references: [testTypeId])

  labTask LabTask?

  @@map("test_order_items")
}

// ================== VIỆN PHÍ / HÓA ĐƠN / THANH TOÁN ==================

model ExaminationFeeCatalog {
  feeId         String   @id @default(uuid()) @map("fee_id") @db.Char(36)
  feeCode       String   @unique @map("fee_code") @db.VarChar(20)
  departmentId  String?  @map("department_id") @db.Char(36)
  feeName       String   @map("fee_name") @db.VarChar(100)
  feeType       String   @default("standard") @map("fee_type") @db.VarChar(20)
  price         Decimal  @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  department Department? @relation(fields: [departmentId], references: [departmentId])

  @@map("examination_fee_catalog")
}

model Invoice {
  invoiceId      String    @id @default(uuid()) @map("invoice_id") @db.Char(36)
  invoiceCode    String    @unique @map("invoice_code") @db.VarChar(20)
  encounterId    String    @map("encounter_id") @db.Char(36)
  patientId      String    @map("patient_id") @db.Char(36)
  invoiceType    String    @map("invoice_type") @db.VarChar(20) // consultation | tests | combined | other
  subtotalAmount Decimal   @map("subtotal_amount") @db.Decimal(14, 2)
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(14, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(14, 2)
  currency       String    @db.VarChar(3)
  status         String    @default("pending") @db.VarChar(20) // pending | paid | cancelled | refunded
  issuedAt       DateTime  @map("issued_at")
  dueAt          DateTime? @map("due_at")
  pdfFileUrl     String?   @map("pdf_file_url") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [encounterId])
  patient   Patient   @relation(fields: [patientId], references: [patientId])

  items    InvoiceItem[]
  payments Payment[]

  @@map("invoices")
}

model InvoiceItem {
  invoiceItemId String   @id @default(uuid()) @map("invoice_item_id") @db.Char(36)
  invoiceId     String   @map("invoice_id") @db.Char(36)
  itemType      String   @map("item_type") @db.VarChar(20)
  sourceId      String   @map("source_id") @db.Char(36)
  description   String   @db.VarChar(255)
  quantity      Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  paymentId        String    @id @default(uuid()) @map("payment_id") @db.Char(36)
  invoiceId        String    @map("invoice_id") @db.Char(36)
  paymentMethod    String    @map("payment_method") @db.VarChar(20) // cash | bank_transfer_qr
  amount           Decimal   @db.Decimal(14, 2)
  status           String    @default("pending") @db.VarChar(20) // pending | success | failed | refunded
  paidAt           DateTime? @map("paid_at")
  receivedByUserId String?   @map("received_by_user_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at")

  invoice        Invoice @relation(fields: [invoiceId], references: [invoiceId])
  receivedByUser User?   @relation("PaymentReceivedByUser", fields: [receivedByUserId], references: [userId])

  gatewayTransaction PaymentGatewayTransaction?

  @@map("payment")
}

model PaymentGatewayTransaction {
  gatewayTransactionId  String    @id @default(uuid()) @map("gateway_transaction_id") @db.Char(36)
  paymentId             String    @unique @map("payment_id") @db.Char(36)
  provider              String    @db.VarChar(30) // vnpay | momo | zalopay | napas | ...
  providerTransactionRef String   @map("provider_transaction_ref") @db.VarChar(100)
  qrCodeData            String?   @map("qr_code_data") @db.VarChar(255)
  requestPayload        Json?     @map("request_payload") @db.JsonB
  responsePayload       Json?     @map("response_payload") @db.JsonB
  status                String    @default("initiated") @db.VarChar(20) // initiated | pending | success | failed | expired
  initiatedAt           DateTime  @map("initiated_at")
  completedAt           DateTime? @map("completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [paymentId], onDelete: Cascade)

  @@map("payment_gateway_transactions")
}

// ================== THÔNG BÁO ==================

model Notification {
  notificationId     String    @id @default(uuid()) @map("notification_id") @db.Char(36)
  recipientUserId    String?   @map("recipient_user_id") @db.Char(36)
  recipientPatientId String?   @map("recipient_patient_id") @db.Char(36)
  notificationType   String    @map("notification_type") @db.VarChar(30) // invoice_issued | payment_success | appointment_reminder | test_result_ready
  channel            String    @db.VarChar(20) // email | sms | zalo_oa | push | in_app
  referenceType      String?   @map("reference_type") @db.VarChar(30)
  referenceId        String?   @map("reference_id") @db.Char(36)
  title              String    @db.VarChar(255)
  content            String    @db.Text
  status             String    @default("queued") @db.VarChar(20) // queued | sent | failed
  sentAt             DateTime? @map("sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  recipientUser    User?    @relation("NotificationRecipientUser", fields: [recipientUserId], references: [userId])
  recipientPatient Patient? @relation(fields: [recipientPatientId], references: [patientId])

  @@map("notifications")
}

// ================== XÉT NGHIỆM - PHÒNG LAB ==================

model LabRoom {
  labRoomId   String   @id @default(uuid()) @map("lab_room_id") @db.Char(36)
  labRoomCode String   @unique @map("lab_room_code") @db.VarChar(20)
  labRoomName String   @map("lab_room_name") @db.VarChar(100)
  category    String   @db.VarChar(30)
  location    String?  @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  testCatalogs     TestCatalog[]
  staffAssignments LabStaffRoomAssignment[]
  labTasks         LabTask[]

  @@map("lab_rooms")
}

model LabStaffRoomAssignment {
  userId     String   @map("user_id") @db.Char(36)
  labRoomId  String   @map("lab_room_id") @db.Char(36)
  isPrimary  Boolean  @default(true) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user    User    @relation("LabStaffAssignments", fields: [userId], references: [userId], onDelete: Cascade)
  labRoom LabRoom @relation(fields: [labRoomId], references: [labRoomId], onDelete: Cascade)

  @@id([userId, labRoomId])
  @@map("lab_staff_room_assignments")
}

model LabTask {
  labTaskId          String    @id @default(uuid()) @map("lab_task_id") @db.Char(36)
  orderItemId        String    @unique @map("order_item_id") @db.Char(36)
  labRoomId          String    @map("lab_room_id") @db.Char(36)
  assignedLabStaffId String?   @map("assigned_lab_staff_id") @db.Char(36)
  paymentVerified    Boolean   @default(false) @map("payment_verified")
  status             String    @default("payment_pending") @db.VarChar(20) // payment_pending => ready => in_progress => completed || cancelled || on_hold
  receivedAt         DateTime? @map("received_at")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  orderItem        TestOrderItem @relation(fields: [orderItemId], references: [orderItemId], onDelete: Cascade)
  labRoom          LabRoom       @relation(fields: [labRoomId], references: [labRoomId])
  assignedLabStaff User?         @relation("LabTaskAssignedStaff", fields: [assignedLabStaffId], references: [userId])

  labResult LabResult?

  @@map("lab_tasks")
}

model LabResultParameter {
  parameterId   String   @id @default(uuid()) @map("parameter_id") @db.Char(36)
  testTypeId    String   @map("test_type_id") @db.Char(36)
  parameterCode String   @map("parameter_code") @db.VarChar(20)
  parameterName String?  @map("parameter_name") @db.VarChar(100)
  loincCode     String?  @map("loinc_code") @db.VarChar(20)
  unit          String?  @db.VarChar(20)
  dataType      String?  @map("data_type") @db.VarChar(20) // numeric | positive_negative | text
  displayOrder  Int      @map("display_order")
  isActive      Boolean? @default(true) @map("is_active")

  testType TestCatalog @relation(fields: [testTypeId], references: [testTypeId])

  labResultValues        LabResultValue[]
  labParameterThresholds LabParameterThreshold[]

  @@unique([testTypeId, parameterCode])
  @@map("lab_result_parameters")
}

model LabResult {
  labResultId       String   @id @default(uuid()) @map("lab_result_id") @db.Char(36)
  labTaskId         String   @unique @map("lab_task_id") @db.Char(36)
  enteredByUserId   String   @map("entered_by_user_id") @db.Char(36)
  reviewedAt        DateTime @map("reviewed_at")
  overallConclusion String?  @map("overall_conclusion") @db.VarChar(255)
  resultStatus      String   @default("preliminary") @map("result_status") @db.VarChar(20) // preliminary | final | corrected | cancelled
  resultedAt        DateTime @map("resulted_at")
  createdAt         DateTime @default(now()) @map("created_at")

  labTask       LabTask @relation(fields: [labTaskId], references: [labTaskId], onDelete: Cascade)
  enteredByUser User    @relation("LabResultEnteredByUser", fields: [enteredByUserId], references: [userId])

  values        LabResultValue[]
  attachments   LabResultAttachment[]
  medicalImages MedicalImage[]
  aiLabAnalyses AiLabAnalysis[]

  @@map("lab_results")
}

model LabResultValue {
  resultValueId String   @id @default(uuid()) @map("result_value_id") @db.Char(36)
  labResultId   String   @map("lab_result_id") @db.Char(36)
  parameterId   String   @map("parameter_id") @db.Char(36)
  valueNumeric  Decimal? @map("value_numeric") @db.Decimal(12, 4)
  valueText     String?  @map("value_text") @db.Text
  isAbnormal    Boolean  @default(false) @map("is_abnormal")
  createdAt     DateTime @default(now()) @map("created_at")

  labResult LabResult          @relation(fields: [labResultId], references: [labResultId], onDelete: Cascade)
  parameter LabResultParameter @relation(fields: [parameterId], references: [parameterId])

  labResultAlerts LabResultAlert[]

  @@unique([labResultId, parameterId])
  @@map("lab_result_values")
}

model LabParameterThreshold {
  labThresholdId  String   @id @default(uuid()) @map("lab_threshold_id") @db.Char(36)
  parameterId     String   @map("parameter_id") @db.Char(36)
  ageMin          Int?     @map("age_min")
  ageMax          Int?     @map("age_max")
  gender          String?  @db.VarChar(10)
  riskLevel       String   @map("risk_level") @db.VarChar(20) // normal | low | medium | high | critical
  rangeMin        Decimal? @map("range_min") @db.Decimal(12, 4)
  rangeMax        Decimal? @map("range_max") @db.Decimal(12, 4)
  isActive        Boolean  @default(true) @map("is_active")
  effectiveFrom   DateTime @map("effective_from") @db.Date
  sourceReference String?  @map("source_reference") @db.Text

  parameter LabResultParameter @relation(fields: [parameterId], references: [parameterId])

  labResultAlerts LabResultAlert[]

  @@map("lab_parameter_thresholds")
}

model LabResultAttachment {
  attachmentId     String   @id @default(uuid()) @map("attachment_id") @db.Char(36)
  labResultId      String   @map("lab_result_id") @db.Char(36)
  fileType         String   @map("file_type") @db.VarChar(20) // image | pdf | raw_export | other
  fileUrl          String   @map("file_url") @db.VarChar(255)
  description      String?  @db.VarChar(255)
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Char(36)
  uploadedAt       DateTime @map("uploaded_at")

  labResult      LabResult @relation(fields: [labResultId], references: [labResultId], onDelete: Cascade)
  uploadedByUser User      @relation("LabAttachmentUploadedByUser", fields: [uploadedByUserId], references: [userId])

  @@map("lab_result_attachments")
}

model LabResultAlert {
  alertId           String    @id @default(uuid()) @map("alert_id") @db.Char(36)
  resultValueId     String    @map("result_value_id") @db.Char(36)
  encounterId       String    @map("encounter_id") @db.Char(36)
  thresholdId       String?   @map("threshold_id") @db.Char(36)
  measuredValue     String    @map("measured_value") @db.VarChar(50)
  riskLevel         String    @map("risk_level") @db.VarChar(20)
  expectedMin       Decimal?  @map("expected_min") @db.Decimal(12, 4)
  expectedMax       Decimal?  @map("expected_max") @db.Decimal(12, 4)
  status            String    @default("active") @db.VarChar(20) // active => confirmed => resolved
  confirmedByUserId String?   @map("confirmed_by_user_id") @db.Char(36)
  confirmedAt       DateTime? @map("confirmed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  resultValue     LabResultValue         @relation(fields: [resultValueId], references: [resultValueId], onDelete: Cascade)
  encounter       Encounter              @relation(fields: [encounterId], references: [encounterId])
  threshold       LabParameterThreshold? @relation(fields: [thresholdId], references: [labThresholdId])
  confirmedByUser User?                  @relation("LabAlertConfirmedByUser", fields: [confirmedByUserId], references: [userId])

  @@map("lab_result_alerts")
}

model AiLabAnalysis {
  aiLabAnalysisId String   @id @default(uuid()) @map("ai_lab_analysis_id") @db.Char(36)
  labResultId     String   @map("lab_result_id") @db.Char(36)
  imageUrl        String   @map("image_url") @db.VarChar(255)
  modelName       String   @map("model_name") @db.VarChar(100)
  modelVersion    String?  @map("model_version") @db.VarChar(20)
  isAnomaly       Boolean  @default(false) @map("is_anomaly")
  finding         String?  @db.VarChar(255)
  confidenceScore Decimal  @map("confidence_score") @db.Decimal(5, 4)
  analyzedAt      DateTime @map("analyzed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  labResult LabResult @relation(fields: [labResultId], references: [labResultId], onDelete: Cascade)

  @@index([labResultId, imageUrl])
  @@map("ai_lab_analyses")
}

// ================== ĐIỀU TRỊ / DỊ ỨNG / TOA THUỐC ==================

model TreatmentConsultation {
  consultationId       String    @id @default(uuid()) @map("consultation_id") @db.Char(36)
  encounterId          String    @unique @map("encounter_id") @db.Char(36)
  doctorId             String    @map("doctor_id") @db.Char(36)
  conditionExplanation String    @map("condition_explanation") @db.Text
  treatmentPlan        String    @map("treatment_plan") @db.Text
  lifestyleAdvice      String?   @map("lifestyle_advice") @db.Text
  nutritionAdvice      String?   @map("nutrition_advice") @db.Text
  followUpRequired     Boolean   @default(false) @map("follow_up_required")
  followUpDate         DateTime? @map("follow_up_date") @db.Date
  consultedAt          DateTime  @map("consulted_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  encounter Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  doctor    Doctor    @relation(fields: [doctorId], references: [doctorId])

  @@map("treatment_consultations")
}

model AllergenCategory {
  categoryId   String   @id @default(uuid()) @map("category_id") @db.Char(36)
  categoryCode String   @unique @map("category_code") @db.VarChar(30)
  categoryName String   @map("category_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  drugs DrugCatalog[]

  @@map("allergen_categories")
}

model DrugCatalog {
  drugId              String   @id @default(uuid()) @map("drug_id") @db.Char(36)
  drugCode            String   @unique @map("drug_code") @db.VarChar(30)
  drugName            String   @map("drug_name") @db.VarChar(255)
  genericName         String   @map("generic_name") @db.VarChar(255)
  strength            String   @db.VarChar(50)
  dosageForm          String   @map("dosage_form") @db.VarChar(50)
  route               String   @db.VarChar(30)
  unit                String   @db.VarChar(20)
  therapeuticClass    String?  @map("therapeutic_class") @db.VarChar(100)
  allergenCategoryId  String?  @map("allergen_category_id") @db.Char(36)
  price               Decimal  @db.Decimal(12, 2)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  allergenCategory AllergenCategory? @relation(fields: [allergenCategoryId], references: [categoryId])

  prescriptionItems PrescriptionItem[]
  interactionsA     DrugInteraction[] @relation("DrugA")
  interactionsB     DrugInteraction[] @relation("DrugB")

  @@map("drug_catalog")
}

model DrugInteraction {
  interactionId String   @id @default(uuid()) @map("interaction_id") @db.Char(36)
  drugIdA       String   @map("drug_id_a") @db.Char(36)
  drugIdB       String   @map("drug_id_b") @db.Char(36)
  severity      String   @db.VarChar(20) // mild | moderate | severe | contraindicated
  description   String   @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  drugA DrugCatalog @relation("DrugA", fields: [drugIdA], references: [drugId])
  drugB DrugCatalog @relation("DrugB", fields: [drugIdB], references: [drugId])

  // Lưu ý: drawio còn có ràng buộc CHECK drug_id_a != drug_id_b — Prisma không hỗ trợ
  // CHECK constraint trực tiếp, cần bổ sung bằng migration SQL thủ công nếu cần.
  @@unique([drugIdA, drugIdB])
  @@map("drug_interaction")
}

model Prescription {
  prescriptionId     String    @id @default(uuid()) @map("prescription_id") @db.Char(36)
  prescriptionCode   String    @unique @map("prescription_code") @db.VarChar(20)
  encounterId        String    @map("encounter_id") @db.Char(36)
  diagnosisId        String    @map("diagnosis_id") @db.Char(36)
  doctorId           String    @map("doctor_id") @db.Char(36)
  status             String    @default("draft") @db.VarChar(20) // draft => signed => dispensed => cancelled
  certificateSerial  String?   @map("certificate_serial") @db.VarChar(100)
  signedAt           DateTime? @map("signed_at")
  pdfFileUrl         String?   @map("pdf_file_url") @db.VarChar(255)
  syncedToPharmacyAt DateTime? @map("synced_to_pharmacy_at")
  issuedAt           DateTime  @map("issued_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  encounter Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [diagnosisId])
  doctor    Doctor    @relation(fields: [doctorId], references: [doctorId])

  items        PrescriptionItem[]
  safetyAlerts PrescriptionSafetyAlert[]

  @@map("prescriptions")
}

model PrescriptionItem {
  prescriptionItemId String   @id @default(uuid()) @map("prescription_item_id") @db.Char(36)
  prescriptionId      String   @map("prescription_id") @db.Char(36)
  drugId               String   @map("drug_id") @db.Char(36)
  quantity             Decimal  @db.Decimal(10, 2)
  dosage               String   @db.VarChar(100)
  routeCode            String?  @map("route_code") @db.VarChar(30)
  routeSystem          String?  @map("route_system") @db.VarChar(255)
  routeDisplay         String?  @map("route_display") @db.VarChar(100)
  frequency            String   @db.VarChar(50)
  durationDays         Int?     @map("duration_days")
  instruction          String?  @db.Text
  unitPrice            Decimal  @map("unit_price") @db.Decimal(12, 2)
  updatedAt            DateTime @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [prescriptionId], onDelete: Cascade)
  drug         DrugCatalog  @relation(fields: [drugId], references: [drugId])

  relatedAlertsA PrescriptionSafetyAlert[] @relation("RelatedItemA")
  relatedAlertsB PrescriptionSafetyAlert[] @relation("RelatedItemB")

  @@map("prescription_items")
}

model PrescriptionSafetyAlert {
  alertId           String    @id @default(uuid()) @map("alert_id") @db.Char(36)
  prescriptionId    String    @map("prescription_id") @db.Char(36)
  alertType         String    @map("alert_type") @db.VarChar(30) // drug_interaction | duplicate_therapeutic_class | allergy_contraindication
  relatedItemIdA    String?   @map("related_item_id_a") @db.Char(36)
  relatedItemIdB    String?   @map("related_item_id_b") @db.Char(36)
  severity          String    @db.VarChar(20) // mild | moderate | severe | contraindicated
  description       String    @db.Text
  status             String   @default("active") @db.VarChar(20) // active => confirmed
  confirmedByUserId String?   @map("confirmed_by_user_id") @db.Char(36)
  confirmedAt       DateTime? @map("confirmed_at")
  overrideReason    String?   @map("override_reason") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")

  prescription    Prescription      @relation(fields: [prescriptionId], references: [prescriptionId], onDelete: Cascade)
  relatedItemA    PrescriptionItem? @relation("RelatedItemA", fields: [relatedItemIdA], references: [prescriptionItemId])
  relatedItemB    PrescriptionItem? @relation("RelatedItemB", fields: [relatedItemIdB], references: [prescriptionItemId])
  confirmedByUser User?             @relation("PrescriptionAlertConfirmedByUser", fields: [confirmedByUserId], references: [userId])

  @@map("prescription_safety_alerts")
}

// ================== HỒ SƠ TÓM TẮT LƯỢT KHÁM ==================

model EncounterSummaryDocument {
  documentId  String   @id @default(uuid()) @map("document_id") @db.Char(36)
  encounterId String   @map("encounter_id") @db.Char(36)
  patientId   String   @map("patient_id") @db.Char(36)
  pdfFileUrl  String   @map("pdf_file_url") @db.VarChar(255)
  generatedAt DateTime @map("generated_at")
  generatedBy String   @default("system") @map("generated_by") @db.VarChar(30) // system | manual
  version     String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  encounter Encounter @relation(fields: [encounterId], references: [encounterId], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [patientId])

  @@map("encounter_summary_documents")
}